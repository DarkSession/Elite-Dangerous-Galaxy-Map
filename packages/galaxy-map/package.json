{
  "name": "@elite-dangerous-almanac/galaxy-map",
  "version": "0.7.0",
  "description": "An interactive 3D map of the Elite Dangerous galaxy, drawn in the browser with WebGL2.",
  "author": "Dark Session",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elite-Dangerous-Almanac/Galaxy-Map.git",
    "directory": "packages/galaxy-map"
  },
  "homepage": "https://elite-dangerous-almanac.github.io/Galaxy-Map/",
  "bugs": {
    "url": "https://github.com/Elite-Dangerous-Almanac/Galaxy-Map/issues"
  },
  "keywords": [
    "elite-dangerous",
    "galaxy-map",
    "webgl",
    "webgl2",
    "3d",
    "starmap",
    "visualisation"
  ],
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./nebulae": {
      "types": "./dist/types/nebulae/index.d.ts",
      "import": "./dist/nebulae.js"
    },
    "./testing": {
      "types": "./dist/types/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "node -e \"require('node:fs').copyFileSync('../../LICENSE.md', 'LICENSE.md')\"",
    "build": "tsc --noEmit -p ../../tsconfig.json && vite build --config vite.config.ts && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@elite-dangerous-almanac/core": "0.2.16",
    "gl-matrix": "^3.4.4"
  },
  "devDependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0"
  }
}
