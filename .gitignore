# Dependencies. pnpm-lock.yaml is committed on purpose -- it is what makes an install
# reproducible, and what the 7-day release hold in pnpm-workspace.yaml pins against.
node_modules/
.pnpm-store/

# Galaxy data dumps. They are large and re-downloadable, so the build script fetches
# them here and the repository never holds one. The entry carries no internal slash, so
# it matches `apps/demo/data/`, which is where the script fetches after the restructure.
data/

# Build output. Each package writes inside itself: `packages/galaxy-map/dist/` is the
# library and `apps/demo/dist/` is the demo site. The entry carries no internal slash,
# so it matches at any depth.
dist/
dist-ssr/

# The copy of the licence the library package's `prepack` makes. `LICENSE.md` at the
# repository root is the one committed source.
packages/galaxy-map/LICENSE.md
# The tarball `npm pack` writes for a publish by hand. `npm publish` reads it from the
# package directory and the repository does not carry it.
packages/*/*.tgz
# The directory `tests/main-bundle.test.ts` builds into. It is removed after the run.
.library-build-*/
# The wiki tree `pnpm docs:wiki` writes, which the pipeline pushes to the repository's
# GitHub wiki. It is generated from the source and from `docs/wiki/`, so it is never
# committed.
wiki-build/
*.local

# Vite's dependency pre-bundling cache
.vite/

# Test output
coverage/
test-results/
playwright-report/
blob-report/
.playwright/
playwright/.cache/

# Environment. .env is for local secrets; commit .env.example instead.
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor and OS noise. .vscode/ is committed on purpose -- the launch configs and
# tasks are part of the dev setup -- so only ignore the per-machine files inside it.
.vscode/*.local
.idea/
*.swp
.DS_Store
Thumbs.db

# Reference images the owner keeps beside the tree. They are not the project's to publish.
.ref/
