{
  "name": "elite-dangerous-galaxy-map",
  "version": "0.5.0",
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./nebulae": {
      "types": "./dist/types/nebulae/index.d.ts",
      "import": "./dist/nebulae.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build --config vite.config.lib.ts && tsc -p tsconfig.build.json",
    "build:demo-site": "vite build",
    "build:demo-data": "node scripts/build-demo-systems.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@elite-dangerous-almanac/core": "0.2.8",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "gl-matrix": "^3.4.4"
  }
}
