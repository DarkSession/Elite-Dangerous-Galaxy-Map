{
  "name": "elite-dangerous-galaxy-map-workspace",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "pnpm --filter @elite-dangerous-almanac/galaxy-map-demo dev",
    "build": "pnpm --filter @elite-dangerous-almanac/galaxy-map build",
    "build:demo-site": "pnpm --filter @elite-dangerous-almanac/galaxy-map-demo build:demo-site",
    "build:demo-data": "pnpm --filter @elite-dangerous-almanac/galaxy-map-demo build:demo-data",
    "build:cycle-data": "pnpm --filter @elite-dangerous-almanac/galaxy-map-demo build:cycle-data",
    "preview": "pnpm --filter @elite-dangerous-almanac/galaxy-map-demo preview",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "test:package": "vitest run tests/packed-tarball.test.ts",
    "docs:wiki": "node scripts/build-wiki.mjs",
    "audit": "pnpm audit --audit-level high",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
